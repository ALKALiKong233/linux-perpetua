# SPDX-License-Identifier: GPL-2.0
#
# Xiaomi 11 Lite 5G NE (lisa)
CONFIG_BUILTIN_DTB_NAME="qcom/sm7325-xiaomi-lisa"

# Display panel (K9D VTDR6130 command-mode DSC AMOLED), built in at boot.
CONFIG_DRM_PANEL_XIAOMI_LISA_K9D=y

# Touchscreen (Goodix GT9897 on SPI13).
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=m

# Haptics (Awinic AW8624 on I2C4).
CONFIG_INPUT_AW8624=m

# Protected smart-amplifier speakers (2x TFA9873 on I2C3, Primary TDM).
CONFIG_SND_SOC_TFA987X_DSP=m

# Ultrawide camera (Sony IMX355 on CSIPHY3).
CONFIG_VIDEO_IMX355=m
CONFIG_CMA_SIZE_MBYTES=256

# Keep zram built in for instant swap setup at boot.
CONFIG_ZRAM=y
