# SPDX-License-Identifier: GPL-2.0
#
# Qualcomm SM7325 (Kodiak / Snapdragon 778G)
CONFIG_NR_CPUS=8

# Multimedia clock controllers, built in for the display and GPU at boot
CONFIG_SC_DISPCC_7280=y
CONFIG_SC_GPUCC_7280=y

# USB 2.0 HS PHY, built in for the USB gadget at boot
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# Take over the watchdog left running by the Android bootloader.
CONFIG_QCOM_WDT=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
